# ========================================================
# NER-LINK AI Platform Environment Variables
# ========================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Gemini AI API Key (Used on backend only; kept out of client bundle)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# OpenWeatherMap API Key (Optional; backend provides resilient fallback)
OPENWEATHER_API_KEY="YOUR_OPENWEATHER_API_KEY_HERE"

# Base App URL
APP_URL="http://localhost:3000"
